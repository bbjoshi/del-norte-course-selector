VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: Set to 'true' to use Firebase emulator in development
# VITE_USE_FIREBASE_EMULATOR=true

# Firebase Admin SDK (server-side) — required to authorize /api/admin/* routes.
# Generate at: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire downloaded JSON file as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
